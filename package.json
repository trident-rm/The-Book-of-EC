{
  "type": "module",
  "imports": {
    "#content/*": "./src/.vitepress/content/*",
    "#nodes/*": "./src/nodes/*"
  },
  "scripts": {
    "dev": "vitepress dev src",
    "diagrams:generate": "node scripts/generate_wavedrom_diagrams.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint src --deny-warnings",
    "lint:fix": "oxlint src --fix",
    "typecheck": "vue-tsc --noEmit",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "build": "vitepress build src",
    "preview": "vitepress preview src"
  },
  "dependencies": {
    "cytoscape": "^3.34.4",
    "cytoscape-dagre": "^4.0.1",
    "motion-v": "^2.8.0"
  },
  "devDependencies": {
    "@types/cytoscape-dagre": "^2.3.4",
    "@types/node": "^24.19.2",
    "mermaid": "^11.17.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "playwright": "1.55.0",
    "typescript": "^5.9.3",
    "vite": "8.2.1",
    "vitepress": "2.0.0-alpha.19",
    "vue": "3.5.41",
    "vue-tsc": "^3.3.13",
    "wavedrom": "^3.8.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.15.0"
}
